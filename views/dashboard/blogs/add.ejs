        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: white;
        border: 1px solid #ced4da;
        z-index: 9999 !important; /* Force it to the front */
        display: none;
        max-height: 250px;
        overflow-y: auto;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-radius: 4px;
    }
    .dropdown-item {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
        color: #333;
    }
    
    .dropdown-item:hover {
        background-color: #f8f9fa;
        color: #007bff;
    }
