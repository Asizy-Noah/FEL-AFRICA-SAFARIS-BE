<form id="editBlogForm" action="/blogs/dashboard/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data">
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="form-group col-md-8">
                    <label><strong>Blog Title</strong></label>
                    <input type="text" name="title" id="blogTitle" class="form-control form-control-lg" 
                           value="<%= blog.title %>" required>
                </div>
                <div class="form-group col-md-4">
                    <label><strong>Status</strong></label>
                    <select name="status" class="form-control form-control-lg">
                        <% blogStatuses.forEach(status => { %>
                            <option value="<%= status %>" <%= blog.status === status ? 'selected' : '' %>><%= status.toUpperCase() %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="form-group mt-3">
                <label><strong>Cover Image</strong></label>
                <% if (blog.coverImage) { %>
                    <div class="mb-2">
                        <img src="<%= blog.coverImage %>" style="height: 100px; border-radius: 5px;" alt="Current Cover">
                    </div>
                <% } %>
                <input type="file" name="coverImage" class="form-control-file" accept="image/*">
                <small class="text-muted">Leave empty to keep current image</small>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Countries</label>
                <div class="multi-select-container" id="countryContainer">
                    <div class="selected-tags-container">
                        <input type="text" class="tag-input-field" placeholder="Search countries..." autocomplete="off">
                    </div>
                    <div class="dropdown-list">
                        <% countries.forEach(function(country) { %>
                            <div class="dropdown-item" data-id="<%= country._id %>">
                                <%= country.name %>
                            </div>
                        <% }); %>
                    </div>
                    <select name="countries" class="hidden-select" multiple style="display: none;">
            <% if (typeof blog !== 'undefined' && blog.countries) { %>
                <% blog.countries.forEach(c => { %>
                    <option value="<%= c._id %>" data-name="<%= c.name %>" selected>
                        <%= c.name %>
                    </option>
                <% }) %>
            <% } %>
        </select>
                </div>
            </div>

            <div class="form-group col-md-6">
                <label>Categories</label>
                <div class="multi-select-container" id="categoryContainer">
                    <div class="selected-tags-container">
                        <input type="text" class="tag-input-field" placeholder="Search categories..." autocomplete="off">
                    </div>
                    <div class="dropdown-list">
                        <% categories.forEach(function(cat) { %>
                            <div class="dropdown-item" data-id="<%= cat._id %>">
                                <%= cat.name %>
                            </div>
                        <% }); %>
                    </div>
                    <select name="categories" class="hidden-select" multiple style="display: none;">
            <% if (typeof blog !== 'undefined' && blog.categories) { %>
                <% blog.categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" data-name="<%= cat.name %>" selected>
                        <%= cat.name %>
                    </option>
                <% }) %>
            <% } %>
        </select>
                </div>
            </div>
        </div>
    </div>

    <div id="blogBuilder" class="mb-4"></div>
    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-white"><strong>SEO & Meta Data</strong></div>
        <div class="card-body">
            <div class="form-group">
                <label>SEO Title</label>
                <input type="text" name="seoTitle" class="form-control" value="<%= blog.seoTitle %>">
            </div>
            <div class="form-group">
                <label>SEO Description</label>
                <textarea name="seoDescription" class="form-control" rows="2"><%= blog.seoDescription %></textarea>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-xl w-100 mb-5">UPDATE BLOG POST</button>
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    let blockCount = 0;
    const builders = [];
    const existingSections = <%- JSON.stringify(blog.sections || []) %>;

    // Map types to their API endpoints for easy lookup during pre-filling
    const apiMap = {
        'tour': '/blogs/api/search-tours',
        'blog': '/blogs/api/search-blogs',
        'destination': '/blogs/api/search-destinations',
        'category': '/blogs/api/search-categories',
        'country': '/blogs/api/search-countries',
        'page': '/api/search-pages'
    };

    window.onload = () => {
        if (existingSections.length > 0) {
            existingSections.forEach((section, index) => renderExistingBlock(section, index));
        } else {
            addBlock('intro');
        }
    };

    // Add a template for the toolbar at the top of your script
const toolbarHtml = `
    <div class="blog-toolbar bg-light p-3 border rounded mb-4 shadow-sm">
        <label class="d-block mb-2 text-primary small"><strong><i class="fas fa-plus-circle"></i> Insert Next Section:</strong></label>
        <div class="btn-group flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBlockAfter(this, 'intro')"><i class="fas fa-align-left"></i> Intro</button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBlockAfter(this, 'paragraph')"><i class="fas fa-paragraph"></i> Paragraph</button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBlockAfter(this, 'tour')"><i class="fas fa-shuttle-van"></i> Tour</button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBlockAfter(this, 'page')"><i class="fas fa-file-alt"></i> Page</button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBlockAfter(this, 'conclusion')"><i class="fas fa-flag-checkered"></i> Conclusion</button>
        </div>
    </div>`;

function addBlock(type, forcedIndex = null) {
    const container = document.getElementById('blogBuilder');
    const blockId = Date.now() + Math.floor(Math.random() * 1000);
    const index = forcedIndex !== null ? forcedIndex : blockCount;
    let specificFields = '';

    if (type === 'paragraph') {
        specificFields = `
            <input type="text" name="sections[${index}][title]" class="form-control mb-2 block-title" placeholder="Sub-heading (Optional)">
            <div id="editor-${blockId}" class="quill-editor" style="height: 200px;"></div>
            <div class="attachment-section mt-4">
                <label class="small text-muted font-weight-bold">ATTACH TO THIS PARAGRAPH:</label>
                <div class="btn-group btn-group-sm d-flex flex-wrap mb-3">
                    ${Object.keys(apiMap).map(t => `
                        <button type="button" class="btn btn-outline-secondary" onclick="addAttachmentLink(${blockId}, '${t}', '${apiMap[t]}')">
                            <i class="fas ${getIcon(t)} mr-1"></i> ${t.charAt(0).toUpperCase() + t.slice(1)}s
                        </button>
                    `).join('')}
                </div>
                <div id="attachment-containers-${blockId}"></div>
            </div>`;
    } else if (type === 'tour' || type === 'page') {
        specificFields = `
            <div class="standalone-attachment-group">
                <div class="selected-tags-container p-2 border rounded bg-light position-relative">
                    <label class="small">Search and Select ${type.toUpperCase()}</label>
                    <input type="text" class="tag-input-field w-100 remote-autocomplete" 
                           data-block="${blockId}" data-type="${type}" 
                           data-api="${apiMap[type]}"
                           placeholder="Type to search...">
                    <div class="dropdown-list"></div>
                </div>
                <div class="selected-items-list d-flex flex-wrap gap-2 mt-2"></div>
                <input type="hidden" name="sections[${index}][referenceId]" class="standalone-ref-val">
            </div>`;
    } else {
        specificFields = `<div id="editor-${blockId}" class="quill-editor" style="height: 150px;"></div>`;
    }

    const blockHtml = `
        <div class="blog-block card mb-3 shadow-sm border-left-primary" data-id="${blockId}" data-type="${type}" data-index="${index}">
            <div class="card-header d-flex justify-content-between align-items-center py-2 bg-white">
                <span class="font-weight-bold text-primary">${type.toUpperCase()}</span>
                <button type="button" class="btn btn-sm text-danger" onclick="removeBlock(this)">&times;</button>
            </div>
            <div class="card-body">
                ${specificFields}
                <input type="hidden" name="sections[${index}][type]" value="${type}">
                <input type="hidden" name="sections[${index}][body]" class="block-body">
            </div>
        </div>
        ${toolbarHtml}`; // ADD TOOLBAR AFTER EVERY BLOCK

    container.insertAdjacentHTML('beforeend', blockHtml);
    
    if (type !== 'tour' && type !== 'page') {
        builders.push({ id: `editor-${blockId}`, quill: new Quill(`#editor-${blockId}`, { theme: 'snow' }) });
    }
    if (forcedIndex === null) blockCount++;
}

// Function to handle toolbar clicks
function addBlockAfter(btn, type) {
    // This allows adding mid-way if you eventually implement sorting
    addBlock(type);
}

function removeBlock(btn) {
    const block = btn.closest('.blog-block');
    const toolbar = block.nextElementSibling;
    if (toolbar && toolbar.classList.contains('blog-toolbar')) {
        toolbar.remove();
    }
    block.remove();
}
    
    function getIcon(type) {
        const icons = { tour: 'fa-shuttle-van', page: 'fa-file', blog: 'fa-blog', country: 'fa-globe', category: 'fa-tags', destination: 'fa-map-marker-alt' };
        return icons[type] || 'fa-link';
    }

    function renderTagIntoUI(blockId, id, text, type, isStandalone = false) {
        let displayList;
        if (isStandalone) {
            displayList = $(`.blog-block[data-id="${blockId}"] .selected-items-list`);
        } else {
            // PASS THE REAL API URL from our map so the search field actually works
            addAttachmentLink(blockId, type, apiMap[type]);
            displayList = $(`#list-${blockId}-${type}`);
        }
        
        const bgColor = isStandalone ? '#28a745' : '#007bff';
        const tagHtml = `
            <div class="country-tag" data-id="${id}" style="background: ${bgColor}; color: white; padding: 4px 12px; border-radius: 15px; display: flex; align-items: center; font-size: 13px; margin-right: 5px; margin-bottom: 5px;">
                <i class="fas ${getIcon(type)} mr-2"></i> ${text}
                <span class="remove-tag" style="margin-left: 8px; cursor: pointer; font-weight: bold;" onclick="this.parentElement.remove()">&times;</span>
                <input type="hidden" class="val-input" value="${id}">
            </div>`;
        displayList.append(tagHtml);
    }

    function addAttachmentLink(blockId, type, apiUrl) {
        const container = document.getElementById(`attachment-containers-${blockId}`);
        if (!container) return;

        // If it already exists, just make sure the API URL is set (fixes the "inactive" issue)
        const existingGroup = container.querySelector(`[data-attach-type="${type}"]`);
        if (existingGroup) {
            const input = existingGroup.querySelector('.remote-autocomplete');
            if (apiUrl && !input.getAttribute('data-api')) {
                input.setAttribute('data-api', apiUrl);
            }
            return;
        }

        const html = `
            <div class="mt-2 mb-3 attachment-sub-group" data-attach-type="${type}">
                <h6 class="small font-weight-bold text-uppercase border-bottom pb-1">Attach ${type}s:</h6>
                <div class="selected-tags-container p-2 border rounded bg-white position-relative">
                    <input type="text" class="tag-input-field remote-autocomplete" 
                           data-block="${blockId}" data-type="${type}" data-api="${apiUrl}" 
                           placeholder="Search ${type}s...">
                    <div class="dropdown-list"></div>
                </div>
                <div id="list-${blockId}-${type}" class="selected-items-list d-flex flex-wrap gap-2 mt-2"></div>
            </div>`;
        container.insertAdjacentHTML('beforeend', html);
    }

    function renderExistingBlock(section, index) {
        addBlock(section.type, index);
        const block = $(`.blog-block[data-index="${index}"]`);
        const blockId = block.data('id');
        const builder = builders.find(b => b.id === `editor-${blockId}`);
        
        if (builder && section.body) builder.quill.root.innerHTML = section.body;
        if (section.title) block.find('.block-title').val(section.title);

        if (section.referenceId) {
            (Array.isArray(section.referenceId) ? section.referenceId : [section.referenceId]).forEach(item => {
                renderTagIntoUI(blockId, item.id, item.text, section.type, true);
            });
        }
        if (section.attachedItems) {
            section.attachedItems.forEach(item => {
                renderTagIntoUI(blockId, item.id, item.text, item.type, false);
            });
        }
    }

    // --- Search Logic ---
    $(document).on('keyup focus click', '.remote-autocomplete', function(e) {
        const input = $(this);
        const api = input.attr('data-api'); // Use .attr to ensure we get the updated value
        const query = input.val();
        const dropdown = input.siblings('.dropdown-list');
        
        if (!api) return; 

        const block = input.closest('.blog-block');
        const selectedIds = block.find('.val-input').map(function() { return $(this).val(); }).get();

        if (e.type === 'keyup' && query.length < 1) { dropdown.hide(); return; }

        $.getJSON(api, { q: query }, function(data) {
            if (!data.length) { dropdown.html('<div class="dropdown-item text-muted">No results found</div>').show(); return; }
            let html = data.map(item => {
                const isSelected = selectedIds.includes(item.id.toString());
                return `<div class="dropdown-item ${isSelected ? 'already-selected' : ''}" 
                             data-id="${item.id}" data-text="${item.text}">${item.text} ${isSelected ? '(Selected)' : ''}</div>`;
            }).join('');
            dropdown.html(html).show();
        });
    });

    $(document).on('click', '.dropdown-item', function() {
        if ($(this).hasClass('already-selected')) return;
        const item = $(this);
        const input = item.closest('.selected-tags-container').find('.remote-autocomplete');
        const isStandalone = item.closest('.standalone-attachment-group').length > 0;
        renderTagIntoUI(input.data('block'), item.data('id'), item.data('text'), input.data('type'), isStandalone);
        input.val('');
        item.closest('.dropdown-list').hide();
    });

    $(document).on('click', function(e) {
        if (!$(e.target).closest('.selected-tags-container').length) $('.dropdown-list').hide();
    });

    // --- Form Submission Fix ---
    $('#editBlogForm').on('submit', function() {
    // 1. Sync Quill editors
    builders.forEach(b => {
        const bId = b.id.replace('editor-', '');
        const bodyContent = b.quill.root.innerHTML;
        // Don't save empty paragraph tags
        const cleanContent = bodyContent === '<p><br></p>' ? '' : bodyContent;
        $(`.blog-block[data-id="${bId}"] .block-body`).val(cleanContent);
    });

    // 2. Process every block to re-index correctly
    $('.blog-block').each(function(index) {
        const b = $(this);
        
        // Update name attributes for all inputs in this block
        b.find('input, select, textarea').each(function() {
            const currentName = $(this).attr('name');
            if (currentName) {
                const newName = currentName.replace(/sections\[\d+\]/, `sections[${index}]`);
                $(this).attr('name', newName);
            }
        });

        // For Standalone Tour/Page blocks:
        if (b.data('type') === 'tour' || b.data('type') === 'page') {
            const firstId = b.find('.val-input').first().val();
            b.find('.standalone-ref-val').attr('name', `sections[${index}][referenceId]`).val(firstId);
        }

        // For Paragraph Attachments:
        b.find('.temp-attachment-input').remove(); // Clear previous
        b.find('.attachment-sub-group .val-input').each(function(i) {
            const val = $(this).val();
            if (val) {
                b.append(`<input type="hidden" name="sections[${index}][attachedItems][${i}]" class="temp-attachment-input" value="${val}">`);
            }
        });
    });

    return true;
});
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {

    const setupMultiselectUI = (containerId) => {
        const container = document.getElementById(containerId);
        const input = container.querySelector('.tag-input-field');
        const dropdown = container.querySelector('.dropdown-list');
        const realSelect = container.querySelector('.hidden-select');
        const tagsContainer = container.querySelector('.selected-tags-container');

        // Function to refresh the visible tags
        const refreshTags = () => {
            tagsContainer.querySelectorAll('.country-tag').forEach(t => t.remove());
            Array.from(realSelect.selectedOptions).forEach(opt => {
                const tag = document.createElement('span');
                tag.className = 'country-tag';
                tag.innerHTML = `${opt.text} <span class="remove-tag" data-id="${opt.value}">&times;</span>`;
                
                tag.querySelector('.remove-tag').onclick = () => {
                    opt.selected = false;
                    realSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    refreshTags();
                };
                tagsContainer.insertBefore(tag, input);
            });
        };

        // Click on dropdown items
        dropdown.onclick = (e) => {
            const item = e.target.closest('.dropdown-item');
            if (!item) return;
            
            const id = item.dataset.id;
            let opt = realSelect.querySelector(`option[value="${id}"]`);
            if (!opt) {
                opt = new Option(item.textContent.trim(), id, true, true);
                realSelect.add(opt);
            } else {
                opt.selected = true;
            }
            
            input.value = '';
            dropdown.style.display = 'none';
            refreshTags();
            realSelect.dispatchEvent(new Event('change', { bubbles: true }));
        };

        // Search logic
        input.oninput = (e) => {
            const val = e.target.value.toLowerCase();
            dropdown.querySelectorAll('.dropdown-item').forEach(item => {
                item.style.display = item.textContent.toLowerCase().includes(val) ? 'block' : 'none';
            });
            dropdown.style.display = 'block';
        };

        input.onfocus = () => { if(dropdown.children.length > 0) dropdown.style.display = 'block'; };

        // Initial tag draw
        refreshTags();
    };

    // Initialize UI for all 3
    setupMultiselectUI('countryContainer');
    setupMultiselectUI('categoryContainer');
    setupMultiselectUI('destinationContainer');

    // --- CASCADING API LOGIC ---

    const updateDependents = async (containerId, apiUrl, ids) => {
        const container = document.getElementById(containerId);
        if (!container) return;

        const dropdown = container.querySelector('.dropdown-list');
        const input = container.querySelector('.tag-input-field');
        
        // Show a "Loading..." message
        dropdown.innerHTML = '<div class="dropdown-item">Loading...</div>';
        dropdown.style.display = 'block';

        try {
            const res = await fetch(`${apiUrl}?ids=${ids.join(',')}`);
            const data = await res.json();
            
            // Clear dropdown
            dropdown.innerHTML = '';

            if (!data || data.length === 0) {
                dropdown.innerHTML = '<div class="dropdown-item">No results found for selected countries</div>';
                input.placeholder = "No items available";
            } else {
                // IMPORTANT: Inject the new items into the dropdown
                data.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'dropdown-item';
                    div.dataset.id = item._id;
                    div.textContent = item.name;
                    dropdown.appendChild(div);
                });
                input.placeholder = "Search...";
            }
        } catch (err) {
            console.error("API Error:", err);
            dropdown.innerHTML = '<div class="dropdown-item text-danger">Error loading data</div>';
        }
    };

    // --- CASCADING LISTENERS ---

    const countrySelect = document.querySelector('#countryContainer .hidden-select');
    const categorySelect = document.querySelector('#categoryContainer .hidden-select');

    // When Countries Change -> Update Categories AND Destinations
    countrySelect.addEventListener('change', function() {
    const ids = Array.from(this.selectedOptions).map(o => o.value);
    if (ids.length > 0) {
        // This MUST match the @Get('api/by-countries') in the controller
        updateDependents('categoryContainer', '/categories/api/by-countries', ids);
    }
});

   
});
</script>

<style>
    .dropdown-item.already-selected {
        opacity: 0.5;
        filter: blur(1px);
        pointer-events: none;
        background-color: #f8f9fa;
        cursor: not-allowed;
    }
    .dropdown-list {
        position: absolute;
        z-index: 1000;
        width: 100%;
        background: white;
        border: 1px solid #ddd;
        max-height: 200px;
        overflow-y: auto;
        display: none;
    }

    .selected-tags-container { position: relative; min-height: 45px; display: flex; align-items: center; }
    .selected-tags-container:focus-within { border-color: #007bff; box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1); }
    .country-tag { background: #007bff; color: white; padding: 4px 12px; border-radius: 15px; display: flex; align-items: center; font-size: 13px; margin-bottom: 5px; }
    .country-tag .remove-tag { margin-left: 8px; cursor: pointer; font-weight: bold; }
    .card-body, .selected-tags-container {
        overflow: visible !important;
    }
    .dropdown-list {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: white;
        border: 1px solid #ced4da;
        z-index: 9999 !important; /* Force it to the front */
        display: none;
        max-height: 250px;
        overflow-y: auto;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-radius: 4px;
    }
    .dropdown-item {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
        color: #333;
    }
    
    .dropdown-item:hover {
        background-color: #f8f9fa;
        color: #007bff;
    }
    .border-left-primary { border-left: 5px solid #007bff !important; }
    .gap-2 { gap: 0.5rem; }
</style>