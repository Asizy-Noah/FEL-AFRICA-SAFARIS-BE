<div class="dashboard-content">
    <div class="content-header">
        <h2 class="content-title">Edit Category: <%= category.name %></h2>
        <div class="content-actions">
            <a href="/categories/dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Categories
            </a>
            <button type="button" class="btn btn-danger" data-category-id="<%= category._id %>" data-category-name="<%= category.name %>" id="deleteCategoryBtn">
                <i class="fas fa-trash"></i> Delete Category
            </button>
        </div>
    </div>

    <form id="editCategoryForm" class="category-form" action="/categories/dashboard/edit/<%= category._id %>?_method=PATCH" method="POST" enctype="multipart/form-data">
        <div class="form-section">
            <h3 class="section-title">Category Information</h3>
            
            <div class="form-group">
                <label for="categoryName">Category Name</label>
                <input type="text" id="categoryName" name="name" class="form-control" value="<%= category.name %>" required>
            </div>

            <div class="form-group">
                <label for="categorySlug">Category Slug (Auto generated)</label>
                <input type="text" id="categorySlug" name="slug" class="form-control" value="<%= category.slug %>">
            </div>

            <div class="form-group">
                <label for="categoryCountry">Associated Countries</label>
                <div class="multi-select-container">
                    <select id="categoryCountry" name="countries" class="form-control hidden-select" multiple>
                        <% countries.forEach(country => { %>
                            <option value="<%= country._id %>"
                                <% if (typeof oldInput !== 'undefined' && oldInput.countries) { %>
                                    <%= oldInput.countries.includes(country._id.toString()) ? 'selected' : '' %>
                                <% } else if (typeof category !== 'undefined' && category.countries) { %>
                                    <%= category.countries.some(c => (c._id || c).toString() === country._id.toString()) ? 'selected' : '' %>
                                <% } %>>
                                <%= country.name %>
                            </option>
                        <% }); %>
                    </select>

                    <div class="selected-tags-container" id="tagsContainer">
                        <input type="text" id="countrySearch" placeholder="Type to search countries..." class="tag-input-field">
                    </div>
                    
                    <div class="dropdown-list" id="countryDropdown">
                        <% countries.forEach(country => { %>
                            <div class="dropdown-item" data-id="<%= country._id %>"><%= country.name %></div>
                        <% }); %>
                    </div>
                </div>
                <small class="form-text text-muted">You can select multiple countries (e.g., Uganda and Rwanda).</small>
            </div>
            
            <div class="form-group">
                <label>Category Description</label>
                <div id="categoryDescriptionEditor" class="editor-container"></div>
                <input type="hidden" name="description" id="categoryDescription" value="<%= category.description %>">
            </div>

            <div class="form-group">
                <label>Current Cover Image</label>
                <div class="row">
                    <div class="col-md-6">
                        <% if (category.image) { %>
                            <div class="current-cover-image">
                                <img src="<%= category.image %>" alt="Current Image" style="max-width: 200px; height: auto; border: 1px solid #ddd; padding: 5px;">
                                <input type="hidden" name="image" value="keep"> 
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="replaceCoverImage" value="new">
                                    <label class="form-check-label" for="replaceCoverImage">
                                        Replace Current Category Image
                                    </label>
                                </div>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No image currently set.</p>
                        <% } %>
                    </div>
                
                    <div class="col-md-6">
                        <div class="file-upload-container mt-3" id="newCoverImageUpload" style="<%= category.image ? 'display: none;' : '' %>">
                        <label for="newCoverImageInput" class="d-block">Upload New Image</label>
                        <input type="file" id="newCoverImageInput" name="image" class="file-input" accept="image/*">
                        <div class="file-upload-box">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span>Drag & drop image or click to browse</span>
                        </div>
                        <div class="file-preview" id="newCoverImagePreview"></div>
                    </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">SEO Information</h3>
            
            <div class="form-group">
                <label for="seoTitle">Meta Title (SEO)</label>
                <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= category.seoTitle || '' %>">
            </div>
            
            <div class="form-group">
                <label for="seoDescription">Meta Description</label>
                <textarea id="seoDescription" name="seoDescription" class="form-control" rows="2"><%= category.seoDescription || '' %></textarea>
            </div>
            
            <div class="form-group">
                <label for="seoKeywords">Meta Keywords</label>
                <input type="text" id="seoKeywords" name="seoKeywords" class="form-control" value="<%= category.seoKeywords || '' %>">
            </div>
        </div>
        
        <div class="form-actions">
            <button type="button" class="btn btn-secondary" onclick="window.location.href='/categories/dashboard'">Cancel</button>
            <button type="submit" class="btn btn-primary">Update Category</button>
        </div>
    </form>
</div>

<link href="/css/form-enhancements.css" rel="stylesheet">

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- Rich Text Editor Initialization ---
        const descriptionEditor = document.getElementById('categoryDescriptionEditor');
        const hiddenDescriptionInput = document.getElementById('categoryDescription');
        let quill;

        if (descriptionEditor && typeof Quill !== 'undefined') {
            quill = new Quill(descriptionEditor, {
                theme: 'snow',
                placeholder: 'Write the detailed description here...',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            if (hiddenDescriptionInput.value) {
                quill.root.innerHTML = hiddenDescriptionInput.value;
            }

            quill.on('text-change', () => {
                hiddenDescriptionInput.value = quill.root.innerHTML;
            });
        } else if (descriptionEditor) {
            const fallbackTextarea = document.createElement('textarea');
            fallbackTextarea.name = 'description';
            fallbackTextarea.className = 'form-control';
            fallbackTextarea.rows = '10';
            fallbackTextarea.value = hiddenDescriptionInput.value;
            descriptionEditor.parentNode.replaceChild(fallbackTextarea, descriptionEditor);
            hiddenDescriptionInput.remove();
        }

        // --- Cover Image Replacement Logic ---
        const replaceCoverImageCheckbox = document.getElementById('replaceCoverImage');
        const newCoverImageUploadContainer = document.getElementById('newCoverImageUpload');
        const newCoverImageInput = document.getElementById('newCoverImageInput');
        const originalImageHiddenInput = document.querySelector('.current-cover-image input[name="image"]');

        if (replaceCoverImageCheckbox) {
            replaceCoverImageCheckbox.addEventListener('change', () => {
                if (replaceCoverImageCheckbox.checked) {
                    newCoverImageUploadContainer.style.display = 'block';
                    if (originalImageHiddenInput) originalImageHiddenInput.value = 'new';
                } else {
                    newCoverImageUploadContainer.style.display = 'none';
                    newCoverImageInput.value = '';
                    document.getElementById('newCoverImagePreview').innerHTML = '';
                    if (originalImageHiddenInput) originalImageHiddenInput.value = 'keep';
                }
            });
        }

        // --- Image Preview ---
        const newCoverImagePreview = document.getElementById('newCoverImagePreview');
        if (newCoverImageInput && newCoverImagePreview) {
            newCoverImageInput.addEventListener('change', (event) => {
                newCoverImagePreview.innerHTML = '';
                const file = event.target.files[0];
                if (file && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.style.maxWidth = '100%';
                        img.style.marginTop = '10px';
                        newCoverImagePreview.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // --- Slug Generation ---
        const categoryNameInput = document.getElementById('categoryName');
        const categorySlugInput = document.getElementById('categorySlug');

        function generateSlug(text) {
            return text.toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim()
                .replace(/\s+/g, '-').replace(/[^\w-]+/g, '').replace(/--+/g, '-');
        }

        categoryNameInput.addEventListener('input', function() {
            if (categorySlugInput.readOnly || categorySlugInput.value === '') {
                categorySlugInput.value = generateSlug(this.value);
            }
        });

        // --- Delete Category Logic ---
        const deleteCategoryBtn = document.getElementById('deleteCategoryBtn');
        if (deleteCategoryBtn) {
            deleteCategoryBtn.addEventListener('click', () => {
                const categoryId = deleteCategoryBtn.dataset.categoryId;
                const categoryName = deleteCategoryBtn.dataset.categoryName;

                if (confirm(`Are you sure you want to delete the category: ${categoryName}?`)) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = `/categories/dashboard/delete/${categoryId}?_method=DELETE`;
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    });

    // --- Multi-Select Country Logic ---
const searchInput = document.getElementById('countrySearch');
const dropdown = document.getElementById('countryDropdown');
const tagsContainer = document.getElementById('tagsContainer');
const realSelect = document.getElementById('categoryCountry');
const dropdownItems = document.querySelectorAll('.dropdown-item');

function updateTags() {
    // Clear existing tags except the input
    const tags = tagsContainer.querySelectorAll('.country-tag');
    tags.forEach(tag => tag.remove());

    // Add tags based on selected options in the real select
    Array.from(realSelect.selectedOptions).forEach(option => {
        const tag = document.createElement('span');
        tag.className = 'country-tag';
        tag.innerHTML = `${option.text} <span class="remove-tag" data-id="${option.value}">&times;</span>`;
        tagsContainer.insertBefore(tag, searchInput);
    });

    // Mark items in dropdown as selected
    dropdownItems.forEach(item => {
        const isSelected = Array.from(realSelect.selectedOptions).some(opt => opt.value === item.dataset.id);
        item.classList.toggle('selected', isSelected);
    });
}

// Show dropdown on focus
searchInput.addEventListener('focus', () => {
    dropdown.style.display = 'block';
});

// Filter dropdown
searchInput.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase();
    dropdownItems.forEach(item => {
        const text = item.textContent.toLowerCase();
        item.style.display = text.includes(term) ? 'block' : 'none';
    });
});

// Handle item selection
dropdown.addEventListener('click', (e) => {
    if (e.target.classList.contains('dropdown-item') && !e.target.classList.contains('selected')) {
        const id = e.target.dataset.id;
        const option = Array.from(realSelect.options).find(opt => opt.value === id);
        if (option) {
            option.selected = true;
            updateTags();
            searchInput.value = '';
            // searchInput.focus();
        }
    }
});

// Handle tag removal
tagsContainer.addEventListener('click', (e) => {
    if (e.target.classList.contains('remove-tag')) {
        const id = e.target.dataset.id;
        const option = Array.from(realSelect.options).find(opt => opt.value === id);
        if (option) {
            option.selected = false;
            updateTags();
        }
    }
});

// Close dropdown when clicking outside
document.addEventListener('click', (e) => {
    if (!e.target.closest('.multi-select-container')) {
        dropdown.style.display = 'none';
    }
});

// Initial load
updateTags();
</script>