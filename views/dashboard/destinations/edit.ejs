<div class="dashboard-content">
    <div class="content-header">
        <h2 class="content-title">Edit Destination: <%= destination.name %></h2>
        <div class="content-actions">
            <a href="/destinations/dashboard/destinations" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Destinations
            </a>
            <form action="/destinations/dashboard/destinations/<%= destination._id %>?_method=DELETE" method="POST" style="display:inline-block;">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>

    <form id="editDestinationForm" action="/destinations/dashboard/destinations/edit/<%= destination._id %>?_method=PATCH" method="POST" enctype="multipart/form-data">
        <div class="form-section">
            <h3 class="section-title">Destination Information</h3>
            <div class="form-group">
                <label for="destinationName">Name</label>
                <input type="text" id="destinationName" name="name" class="form-control" required value="<%= destination.name %>">
            </div>

            <div class="form-group">
                <label for="destinationCountry">Country</label>
                <select id="destinationCountry" name="country" class="form-control" required>
                    <option value="">Select Country</option>
                    <% countries.forEach(function(country) { %>
                        <option value="<%= country._id %>" <%= destination.country && destination.country._id && destination.country._id.toString() === country._id.toString() ? 'selected' : (destination.country && destination.country.toString && destination.country.toString() === country._id.toString() ? 'selected' : '') %>><%= country.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="destinationCategories">Categories</label>
                <div class="custom-multiselect-container">
                    <div class="multiselect-trigger">
                        <div class="multiselect-placeholder">Select Categories</div>
                        <div class="multiselect-tags" id="selectedCategoriesTags"></div>
                        <i class="fas fa-chevron-down multiselect-arrow"></i>
                    </div>
                    <select id="destinationCategories" name="categories" class="custom-multiselect" multiple>
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat._id %>" <%= destination.categories && destination.categories.some(c => (c._id ? c._id.toString() : c.toString()) === cat._id.toString()) ? 'selected' : '' %>><%= cat.name %></option>
                        <% }); %>
                    </select>
                    <div class="multiselect-dropdown" id="categoriesDropdown">
                        <div class="multiselect-search">
                            <input type="text" class="multiselect-search-input" placeholder="Search categories...">
                        </div>
                        <div class="multiselect-options" id="categoriesOptions">
                            <% categories.forEach(function(cat) { %>
                                <label class="multiselect-option">
                                    <input type="checkbox" value="<%= cat._id %>" data-label="<%= cat.name %>" <%= destination.categories && destination.categories.some(c => (c._id ? c._id.toString() : c.toString()) === cat._id.toString()) ? 'checked' : '' %>>
                                    <span><%= cat.name %></span>
                                </label>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="coverImage">Cover Image</label>
                <div class="file-upload-container">
                    <div class="file-upload-content">
                        <div class="file-current-image">
                            <% if (destination.coverImage) { %>
                                <div class="current-image-preview">
                                    <img src="<%= destination.coverImage %>" alt="Current Cover Image">
                                    <div class="image-actions">
                                        <label class="image-action-label">
                                            <input type="checkbox" name="removeImage" class="remove-cover-image-checkbox">
                                            <span>Remove Image</span>
                                        </label>
                                    </div>
                                    <input type="hidden" name="currentCoverImage" value="<%= destination.coverImage %>">
                                </div>
                            <% } %>
                        </div>
                        <div class="file-upload-box">
                            <input type="file" id="coverImage" name="coverImage" class="file-input" accept="image/*">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span>Drag & drop image or click to browse</span>
                        </div>
                    </div>
                    <div class="file-preview" id="imagePreview">
                        <img src="" alt="Image Preview" style="display: none;">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" class="form-control" rows="6"><%= destination.description %></textarea>
            </div>

            <h3 class="section-title">SEO</h3>
            <div class="form-group">
                <label for="seoTitle">Meta Title</label>
                <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= destination.seoTitle || '' %>">
            </div>
            <div class="form-group">
                <label for="seoDescription">Meta Description</label>
                <textarea id="seoDescription" name="seoDescription" class="form-control" rows="3"><%= destination.seoDescription || '' %></textarea>
            </div>
            <div class="form-group">
                <label for="seoKeywords">Meta Keywords</label>
                <input type="text" id="seoKeywords" name="seoKeywords" class="form-control" value="<%= destination.seoKeywords || '' %>">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Destination</button>
        </div>
    </form>
</div>

<script src="/js/multiselect.js"></script>
<link href="/css/multiselect.css" rel="stylesheet">
<link href="/css/form-enhancements.css" rel="stylesheet">

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize multiselect for categories
        new MultiSelect('destinationCategories', {
            placeholder: 'Select Categories'
        });

        // Image preview
        const coverImageInput = document.getElementById('coverImage');
        const imagePreview = document.getElementById('imagePreview');
        const imagePreviewImg = imagePreview.querySelector('img');
        const removeCheckbox = document.querySelector('.remove-cover-image-checkbox');
        const currentImagePreview = document.querySelector('.current-image-preview');

        coverImageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreviewImg.src = e.target.result;
                    imagePreviewImg.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                imagePreviewImg.src = '';
                imagePreviewImg.style.display = 'none';
            }
        });

        if (removeCheckbox) {
            removeCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    currentImagePreview.style.opacity = '0.5';
                } else {
                    currentImagePreview.style.opacity = '1';
                }
            });
        }
    });
</script>
