<div class="dashboard-content">
    <div class="content-header">
        <h2 class="content-title">Edit Destination: <%= destination.name %></h2>
        <div class="content-actions">
            <a href="/destinations/dashboard/destinations" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Destinations
            </a>
            <form action="/destinations/dashboard/destinations/<%= destination._id %>?_method=DELETE" method="POST" style="display:inline-block;">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>

    <form id="editDestinationForm" action="/destinations/dashboard/destinations/edit/<%= destination._id %>?_method=PATCH" method="POST" enctype="multipart/form-data">
        <div class="form-section">
            <h3 class="section-title">Destination Information</h3>
            <div class="form-group">
                <label for="destinationName">Name</label>
                <input type="text" id="destinationName" name="name" class="form-control" required value="<%= destination.name %>">
            </div>

            <div class="form-group">
                <label for="destinationCountry">Country</label>
                <select id="destinationCountry" name="country" class="form-control" required>
                    <option value="">Select Country</option>
                    <% countries.forEach(function(country) { %>
                        <option value="<%= country._id %>" <%= destination.country && destination.country._id && destination.country._id.toString() === country._id.toString() ? 'selected' : (destination.country && destination.country.toString && destination.country.toString() === country._id.toString() ? 'selected' : '') %>><%= country.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="destinationCategories">Categories</label>
                <div class="multi-select-container" id="categoryMultiSelectContainer">
                    <div class="selected-tags-container" id="categoryTagsContainer">
                        <input type="text" id="categorySearchInput" class="tag-input-field" placeholder="Select Country first..." autocomplete="off">
                    </div>
                    
                    <div class="dropdown-list" id="categoryDropdown">
                        </div>

                    <select id="destinationCategories" name="categories" class="hidden-select" multiple required>
                        <% if (typeof destination !== 'undefined' && destination.categories) { %>
                            <% destination.categories.forEach(cat => { %>
                                <option value="<%= cat._id %>" selected><%= cat.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Cover Image</label>
                <div class="image-edit-wrapper">
                    <div class="current-image-section">
                        <% if (destination.coverImage) { %>
                            <div class="current-image-card">
                                <img src="<%= destination.coverImage %>" alt="Current Cover" id="mainImageDisplay">
                                <div class="form-check mt-2">
                                    <input class="form-check-input replace-toggle" type="checkbox" id="replaceImageCheckbox" name="replaceImage">
                                    <label class="form-check-label" for="replaceImageCheckbox">
                                        Replace Image
                                    </label>
                                </div>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No cover image set.</p>
                        <% } %>
                    </div>

                    <div class="new-upload-section" id="uploadContainer" style="<%= destination.coverImage ? 'display: none;' : '' %>">
                        <div class="file-upload-container">
                            <label for="coverImageInput" class="file-upload-box" id="dropZone">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2"></i>
                                <p class="mb-0">Click or Drag & Drop new image</p>
                                <input type="file" id="coverImageInput" name="coverImage" class="file-input" accept="image/*">
                            </label>
                            <div id="imagePreview" class="file-preview"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="destinationDescription">Description</label>
                <div id="destinationDescriptionEditor" class="editor-container" style="height: 100px; background: white;"></div>
                <input type="hidden" name="description" id="destinationDescription" value="<%= destination.description %>">
            </div>

            <h3 class="section-title">SEO</h3>
            <div class="form-group">
                <label for="seoTitle">Meta Title</label>
                <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= destination.seoTitle || '' %>">
            </div>
            <div class="form-group">
                <label for="seoDescription">Meta Description</label>
                <textarea id="seoDescription" name="seoDescription" class="form-control" rows="3"><%= destination.seoDescription || '' %></textarea>
            </div>
            <div class="form-group">
                <label for="seoKeywords">Meta Keywords</label>
                <input type="text" id="seoKeywords" name="seoKeywords" class="form-control" value="<%= destination.seoKeywords || '' %>">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Destination</button>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const countrySelect = document.getElementById('destinationCountry');
    const searchInput = document.getElementById('categorySearchInput');
    const dropdown = document.getElementById('categoryDropdown');
    const tagsContainer = document.getElementById('categoryTagsContainer');
    const realSelect = document.getElementById('destinationCategories');

    // 1. Helper: Update Visual Tags
    function updateTags() {
        tagsContainer.querySelectorAll('.country-tag').forEach(tag => tag.remove());

        Array.from(realSelect.selectedOptions).forEach(option => {
            const tag = document.createElement('span');
            tag.className = 'country-tag';
            tag.innerHTML = `${option.text} <span class="remove-tag" data-id="${option.value}">&times;</span>`;
            tagsContainer.insertBefore(tag, searchInput);
        });

        dropdown.querySelectorAll('.dropdown-item').forEach(item => {
            const isSelected = Array.from(realSelect.selectedOptions).some(opt => opt.value === item.dataset.id);
            item.classList.toggle('selected', isSelected);
        });
    }

    // 2. Core: Load Categories
    // Added 'isInitialLoad' to prevent wiping out existing data
    async function loadCategories(countryId, isInitialLoad = false) {
        if (!countryId) {
            dropdown.innerHTML = '';
            if(!isInitialLoad) realSelect.innerHTML = '';
            return;
        }

        try {
            const response = await fetch(`/categories/api/by-country/${countryId}`);
            const categories = await response.json();
            
            dropdown.innerHTML = '';

            // Map current IDs to keep track of what's already selected
            const selectedIds = Array.from(realSelect.selectedOptions).map(opt => opt.value);

            // If the user manually changed the country, we clear the hidden select
            if (!isInitialLoad) {
                realSelect.innerHTML = '';
            }

            if (categories.length === 0) {
                dropdown.innerHTML = '<div class="dropdown-item">No categories for this country</div>';
                return;
            }

            categories.forEach(cat => {
                // Ensure category exists in the real hidden select
                if (!Array.from(realSelect.options).some(opt => opt.value === cat._id)) {
                    const opt = document.createElement('option');
                    opt.value = cat._id;
                    opt.text = cat.name;
                    // Keep it selected if it was in our saved list
                    if (selectedIds.includes(cat._id)) opt.selected = true;
                    realSelect.appendChild(opt);
                }

                // Add to visual dropdown
                const item = document.createElement('div');
                item.className = 'dropdown-item';
                item.dataset.id = cat._id;
                item.textContent = cat.name;
                dropdown.appendChild(item);
            });

            searchInput.placeholder = "Search categories...";
            updateTags();

        } catch (err) {
            console.error("Fetch Error:", err);
        }
    }

    // --- Listeners ---

    countrySelect.addEventListener('change', function() {
        // When changing country manually, we DO want to clear previous categories
        loadCategories(this.value, false);
    });

    dropdown.addEventListener('click', (e) => {
        const item = e.target.closest('.dropdown-item');
        if (item) {
            const id = item.dataset.id;
            const option = Array.from(realSelect.options).find(opt => opt.value === id);
            if (option) {
                option.selected = !option.selected; // Toggle
                updateTags();
            }
        }
    });

    tagsContainer.addEventListener('click', (e) => {
        if (e.target.classList.contains('remove-tag')) {
            const id = e.target.dataset.id;
            const option = Array.from(realSelect.options).find(opt => opt.value === id);
            if (option) {
                option.selected = false;
                updateTags();
            }
        }
    });

    searchInput.addEventListener('focus', () => { if(dropdown.children.length) dropdown.style.display = 'block'; });

    // Initial load for Edit Page (Crucial: set isInitialLoad to true)
    if (countrySelect.value) {
        loadCategories(countrySelect.value, true);
    }
});

/* =====Txeditor logic========= */
document.addEventListener('DOMContentLoaded', () => {
    // --- Rich Text Editor Initialization ---
    const descriptionEditor = document.getElementById('destinationDescriptionEditor');
    const hiddenDescriptionInput = document.getElementById('destinationDescription');
    let quill;

    if (descriptionEditor && typeof Quill !== 'undefined') {
        quill = new Quill(descriptionEditor, {
            theme: 'snow',
            placeholder: 'Write the detailed destination description here...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        // Load existing content if editing
        if (hiddenDescriptionInput.value) {
            quill.root.innerHTML = hiddenDescriptionInput.value;
        }

        // Sync Quill content to hidden input on every change
        quill.on('text-change', () => {
            hiddenDescriptionInput.value = quill.root.innerHTML;
        });
        
    } else if (descriptionEditor) {
        // Fallback for failed library load
        const fallbackTextarea = document.createElement('textarea');
        fallbackTextarea.name = 'description';
        fallbackTextarea.className = 'form-control';
        fallbackTextarea.rows = '10';
        fallbackTextarea.value = hiddenDescriptionInput.value;
        descriptionEditor.parentNode.replaceChild(fallbackTextarea, descriptionEditor);
        hiddenDescriptionInput.remove();
    }
});
</script>
