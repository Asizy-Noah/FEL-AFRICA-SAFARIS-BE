<div class="dashboard-content">
    <form id="editPartnerForm" action="/partners/dashboard/edit/<%= partner._id %>?_method=PATCH" method="POST" enctype="multipart/form-data">
        <div class="card shadow mb-4">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">Edit Partner: <%= partner.name %></h6>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="font-weight-bold">Partner Name</label>
                    <input type="text" name="name" class="form-control" value="<%= partner.name %>" required>
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Website URL</label>
                    <input type="url" name="url" class="form-control" value="<%= partner.url %>">
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Change Logo</label>
                    <div class="custom-file-upload">
                        <input type="file" id="partnerLogo" name="logo" accept="image/*" class="d-none">
                        <div id="logoBox" class="border p-4 text-center rounded" style="cursor: pointer; border-style: dashed !important;">
                            <i class="fas fa-image fa-2x mb-2 text-info"></i>
                            <p class="mb-0">Click to change logo</p>
                        </div>
                        <div id="logoPreview" class="mt-3 text-center">
                            <% if (partner.logo) { %>
                                <img src="<%= partner.logo %>" style="max-height: 150px; border-radius: 8px;">
                                <p class="text-muted small mt-1">Current Logo</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-info px-5">Update Partner</button>
                <a href="/partners/dashboard" class="btn btn-link">Cancel</a>
            </div>
        </div>
    </form>
</div>

<script>
    const logoInput = document.getElementById('partnerLogo');
    const logoBox = document.getElementById('logoBox');
    const logoPreview = document.getElementById('logoPreview');

    logoBox.addEventListener('click', () => logoInput.click());

    logoInput.addEventListener('change', function(e) {
        if (e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = (ex) => {
                logoPreview.innerHTML = `
                    <img src="${ex.target.result}" style="max-height: 150px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                    <p class="text-success small mt-1">New logo selected</p>
                `;
            };
            reader.readAsDataURL(e.target.files[0]);
        }
    });
</script>