<div class="dashboard-content">
    <form action="/tours/dashboard/tours/add" method="POST" enctype="multipart/form-data" id="addTourForm" class="add-tour-form">
        <div class="form-section">
            <div class="form-group">
                <label for="tourTitle">Title</label>
                <input type="text" id="tourTitle" name="title" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.title : '' %>" required>
            </div>

            <!-- <div class="form-group">
                <label for="tourSummary">Tour Summary (For tour card)</label>
                <textarea id="tourSummary" name="summary" class="form-control" rows="6" placeholder="Write each highlight on a new line"><%= typeof oldInput !== 'undefined' ? oldInput.summary : '' %></textarea>
            </div> -->

            <div class="form-group">
                <label for="tourOverview">Tour Overview</label>
                <div id="tourOverviewEditor" class="editor-container"><%- typeof oldInput !== 'undefined' ? oldInput.overview : '' %></div>
                <input type="hidden" name="overview" id="tourOverview" value="<%= typeof oldInput !== 'undefined' ? oldInput.overview : '' %>">
            </div> 

            <div class="column-inputs">
                <div class="form-group">
                <label for="tourHighlights">Tour Highlights</label>
                <textarea id="tourHighlights" name="highlights" class="form-control" rows="6" ><%= typeof oldInput !== 'undefined' ? oldInput.highlights : '' %></textarea>
                </div>

                <div class="form-group">
                <label for="coverImage">Upload Cover Image</label>
                <div class="file-upload-container">
                    <input type="file" id="coverImage" name="coverImage" class="file-input" accept="image/*">
                    <div class="file-upload-box">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <h4 class="upload-title">Add Cover Image</h4>
                        <p class="upload-text">Drag & drop image here or click to browse</p>
                        <small class="upload-hint">Recommended: 1200x600px (2:1 ratio), Max 5MB</small>
                    </div>
                    <div class="file-preview" id="imagePreview">
                        <img src="" alt="Image Preview" style="display: none;">
                    </div>
                </div>
                </div>
            </div>

        </div>

        <div class="form-section">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Countries</label>
                    <div class="multi-select-container" id="countryContainer">
                        <div class="selected-tags-container">
                            <input type="text" class="tag-input-field" placeholder="Search countries..." autocomplete="off">
                        </div>
                        <div class="dropdown-list">
                            <% countries.forEach(function(country) { %>
                                <div class="dropdown-item" data-id="<%= country._id %>">
                                    <%= country.name %>
                                </div>
                            <% }); %>
                        </div>
                        <select name="countries" class="hidden-select" multiple required>
                            <% if (typeof tour !== 'undefined' && tour.countries) { %>
                                <% tour.countries.forEach(c => { %>
                                    <option value="<%= c._id %>" selected><%= c.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label>Categories</label>
                    <div class="multi-select-container" id="categoryContainer">
                        <div class="selected-tags-container">
                            <input type="text" class="tag-input-field" placeholder="Select Country first..." autocomplete="off">
                        </div>
                        <div class="dropdown-list"></div>
                        <select name="categories" class="hidden-select" multiple required>
                            <% if (typeof tour !== 'undefined' && tour.categories) { %>
                                <% tour.categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" selected><%= cat.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label>Destinations</label>
                    <div class="multi-select-container" id="destinationContainer">
                        <div class="selected-tags-container">
                            <input type="text" class="tag-input-field" placeholder="Select Categories first..." autocomplete="off">
                        </div>
                        <div class="dropdown-list"></div>
                        <select name="destinations" class="hidden-select" multiple required>
                            <% if (typeof tour !== 'undefined' && tour.destinations) { %>
                                <% tour.destinations.forEach(d => { %>
                                    <option value="<%= d._id %>" selected><%= d.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4"> <label for="days">Number of Days</label>
                    <input type="number" id="days" name="days" class="form-control" min="1" value="<%= typeof oldInput !== 'undefined' ? oldInput.days : '' %>" required>
                </div>

                <div class="form-group col-md-4">
                    <label for="groupSize">Number of Travelers (Max)</label>
                    <input type="number" id="groupSize" name="groupSize" class="form-control" min="1" value="<%= typeof oldInput !== 'undefined' ? oldInput.groupSize : '1' %>" required>
                </div>

                <div class="form-group col-md-4">
                    <label for="price">Price ($)</label>
                    <input type="number" id="price" name="price" class="form-control" min="0" step="0.01" value="<%= typeof oldInput !== 'undefined' ? oldInput.price : '' %>" required>
                </div>
            </div>

            <div class="column-inputs">
                <div class="form-group">
                <label for="priceIncludes">Cost Includes</label>
                <textarea id="priceIncludes" name="priceIncludes" class="form-control" rows="5"><%= typeof oldInput !== 'undefined' ? oldInput.priceIncludes : '' %></textarea>
                </div>

                <div class="form-group">
                <label for="priceExcludes">Cost Excludes</label>
                <textarea id="priceExcludes" name="priceExcludes" class="form-control" rows="5" ><%= typeof oldInput !== 'undefined' ? oldInput.priceExcludes : '' %></textarea>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">Itineraries</h3>
            <div id="itinerariesContainer">
                <% if (typeof oldInput !== 'undefined' && oldInput.itineraries && oldInput.itineraries.length > 0) { %>
                    <% oldInput.itineraries.forEach(function(itinerary, index) { %>
                        <div class="itinerary-item">
                            <div class="itinerary-header">
                                <h4>Itinerary <%= index + 1 %></h4>
                                <button type="button" class="remove-itinerary-btn" title="Remove Itinerary">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-2 col-sm-2">
                                    <label>Day</label>
                                    <input type="text" name="itineraries[<%= index %>][day]" class="form-control"  value="<%= itinerary.day %>" required>
                                </div>

                                <div class="form-group col-md-10 col-sm-10">
                                    <label>Itinerary Title</label>
                                    <input type="text" name="itineraries[<%= index %>][title]" class="form-control" value="<%= itinerary.title %>" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Itinerary Description</label>
                                <div class="itinerary-editor editor-container"><%- itinerary.description %></div>
                                <input type="hidden" name="itineraries[<%= index %>][description]" value="<%= itinerary.description %>">
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Meal Plan</label>
                                    <select name="itineraries[<%= index %>][meals]" class="form-control" required>
                                        <option value="">Select Meal Plan</option>
                                        <option value="Lunch & Dinner" <%= (itinerary.meals === 'Lunch & Dinner') ? 'selected' : '' %>>Lunch & Dinner</option>
                                        <option value="Breakfast, Lunch & Dinner" <%= (itinerary.meals === 'Breakfast, Lunch & Dinner') ? 'selected' : '' %>>Breakfast, Lunch & Dinner</option>
                                        <option value="Breakfast & Lunch" <%= (itinerary.meals === 'Breakfast & Lunch') ? 'selected' : '' %>>Breakfast & Lunch</option>
                                        <option value="Breakfast Only" <%= (itinerary.meals === 'Breakfast Only') ? 'selected' : '' %>>Breakfast Only</option>
                                    </select>
                                </div>

                                <div class="form-group col-md-6">
                                    <label>Accommodation</label>
                                    <input type="text" name="itineraries[<%= index %>][accommodation]" class="form-control"  value="<%= itinerary.accommodation %>">
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="itinerary-item">
                        <div class="itinerary-header">
                            <h4>Itinerary 1</h4>
                            <button type="button" class="remove-itinerary-btn" title="Remove Itinerary">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-2 col-sm-2">
                                <label>Day</label>
                                <input type="text" name="itineraries[0][day]" class="form-control"  required>
                            </div>

                            <div class="form-group col-md-10 col-sm-10">
                                <label>Itinerary Title</label>
                                <input type="text" name="itineraries[0][title]" class="form-control" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Itinerary Description</label>
                            <div class="itinerary-editor editor-container"></div>
                            <input type="hidden" name="itineraries[0][description]">
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Meal Plan</label>
                                <select name="itineraries[0][meals]" class="form-control" required>
                                    <option value="">Select Meal Plan</option>
                                    <option value="Lunch & Dinner">Lunch & Dinner</option>
                                    <option value="Breakfast, Lunch & Dinner">Breakfast, Lunch & Dinner</option>
                                    <option value="Breakfast & Lunch">Breakfast & Lunch</option>
                                    <option value="Breakfast Only">Breakfast Only</option>
                                </select>
                            </div>

                            <div class="form-group col-md-6">
                                <label>Accommodation</label>
                                <input type="text" name="itineraries[0][accommodation]" class="form-control" >
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <button type="button" id="addItineraryBtn" class="btn btn-outline">
                <i class="fas fa-plus"></i> Add Itinerary
            </button>
        </div>

        <div class="form-section">
            <h3 class="section-title">Additional Information</h3>
            <div class="form-group">
                <label for="additionalInfo">Important Notes / Extra Info</label>
                <textarea id="additionalInfo" name="additionalInfo" class="form-control" rows="5"><%= typeof oldInput !== 'undefined' ? oldInput.additionalInfo : '' %></textarea>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">SEO Information</h3>

            <div class="form-group">
                <label for="seoTitle">Meta Title</label>
                <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.seoTitle : '' %>" >
            </div>

            <div class="form-group">
                <label for="seoDescription">Meta Description</label>
                <textarea id="seoDescription" name="seoDescription" class="form-control" rows="3" maxlength="150"><%= typeof oldInput !== 'undefined' ? oldInput.seoDescription : '' %></textarea>
                <small id="charCount">0 / 150</small>
            </div>

            <div class="form-group">
                <label for="seoKeywords">Meta Keywords</label>
                <input type="text" id="seoKeywords" name="seoKeywords" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.seoKeywords : '' %>" >
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Tour</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {

    const setupMultiselectUI = (containerId) => {
        const container = document.getElementById(containerId);
        const input = container.querySelector('.tag-input-field');
        const dropdown = container.querySelector('.dropdown-list');
        const realSelect = container.querySelector('.hidden-select');
        const tagsContainer = container.querySelector('.selected-tags-container');

        // Function to refresh the visible tags
        const refreshTags = () => {
            tagsContainer.querySelectorAll('.country-tag').forEach(t => t.remove());
            Array.from(realSelect.selectedOptions).forEach(opt => {
                const tag = document.createElement('span');
                tag.className = 'country-tag';
                tag.innerHTML = `${opt.text} <span class="remove-tag" data-id="${opt.value}">&times;</span>`;
                
                tag.querySelector('.remove-tag').onclick = () => {
                    opt.selected = false;
                    realSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    refreshTags();
                };
                tagsContainer.insertBefore(tag, input);
            });
        };

        // Click on dropdown items
        dropdown.onclick = (e) => {
            const item = e.target.closest('.dropdown-item');
            if (!item) return;
            
            const id = item.dataset.id;
            let opt = realSelect.querySelector(`option[value="${id}"]`);
            if (!opt) {
                opt = new Option(item.textContent.trim(), id, true, true);
                realSelect.add(opt);
            } else {
                opt.selected = true;
            }
            
            input.value = '';
            dropdown.style.display = 'none';
            refreshTags();
            realSelect.dispatchEvent(new Event('change', { bubbles: true }));
        };

        // Search logic
        input.oninput = (e) => {
            const val = e.target.value.toLowerCase();
            dropdown.querySelectorAll('.dropdown-item').forEach(item => {
                item.style.display = item.textContent.toLowerCase().includes(val) ? 'block' : 'none';
            });
            dropdown.style.display = 'block';
        };

        input.onfocus = () => { if(dropdown.children.length > 0) dropdown.style.display = 'block'; };

        // Initial tag draw
        refreshTags();
    };

    // Initialize UI for all 3
    setupMultiselectUI('countryContainer');
    setupMultiselectUI('categoryContainer');
    setupMultiselectUI('destinationContainer');

    // --- CASCADING API LOGIC ---

    const updateDependents = async (containerId, apiUrl, ids) => {
        const container = document.getElementById(containerId);
        if (!container) return;

        const dropdown = container.querySelector('.dropdown-list');
        const input = container.querySelector('.tag-input-field');
        
        // Show a "Loading..." message
        dropdown.innerHTML = '<div class="dropdown-item">Loading...</div>';
        dropdown.style.display = 'block';

        try {
            const res = await fetch(`${apiUrl}?ids=${ids.join(',')}`);
            const data = await res.json();
            
            // Clear dropdown
            dropdown.innerHTML = '';

            if (!data || data.length === 0) {
                dropdown.innerHTML = '<div class="dropdown-item">No results found for selected countries</div>';
                input.placeholder = "No items available";
            } else {
                // IMPORTANT: Inject the new items into the dropdown
                data.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'dropdown-item';
                    div.dataset.id = item._id;
                    div.textContent = item.name;
                    dropdown.appendChild(div);
                });
                input.placeholder = "Search...";
            }
        } catch (err) {
            console.error("API Error:", err);
            dropdown.innerHTML = '<div class="dropdown-item text-danger">Error loading data</div>';
        }
    };

    // --- CASCADING LISTENERS ---

    const countrySelect = document.querySelector('#countryContainer .hidden-select');
    const categorySelect = document.querySelector('#categoryContainer .hidden-select');

    // When Countries Change -> Update Categories AND Destinations
    countrySelect.addEventListener('change', function() {
    const ids = Array.from(this.selectedOptions).map(o => o.value);
    if (ids.length > 0) {
        // This MUST match the @Get('api/by-countries') in the controller
        updateDependents('categoryContainer', '/categories/api/by-countries', ids);
        
        // This one is likely working because your Destinations controller already has 'by-countries'
        updateDependents('destinationContainer', '/destinations/api/by-countries', ids);
    }
});

   
});
</script>

