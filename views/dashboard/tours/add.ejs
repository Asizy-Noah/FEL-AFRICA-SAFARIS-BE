<div class="dashboard-content">
    <form action="/tours/dashboard/tours/add" method="POST" enctype="multipart/form-data" id="addTourForm" class="add-tour-form">
        <div class="form-section">
            <div class="form-group">
                <label for="tourTitle">Title</label>
                <input type="text" id="tourTitle" name="title" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.title : '' %>" required>
            </div>

            <!-- <div class="form-group">
                <label for="tourSummary">Tour Summary (For tour card)</label>
                <textarea id="tourSummary" name="summary" class="form-control" rows="6" placeholder="Write each highlight on a new line"><%= typeof oldInput !== 'undefined' ? oldInput.summary : '' %></textarea>
            </div> -->

            <div class="form-group">
                <label for="tourOverview">Tour Overview</label>
                <div id="tourOverviewEditor" class="editor-container"><%- typeof oldInput !== 'undefined' ? oldInput.overview : '' %></div>
                <input type="hidden" name="overview" id="tourOverview" value="<%= typeof oldInput !== 'undefined' ? oldInput.overview : '' %>">
            </div> 

            <div class="column-inputs">
                <div class="form-group">
                <label for="tourHighlights">Tour Highlights</label>
                <textarea id="tourHighlights" name="highlights" class="form-control" rows="6" ><%= typeof oldInput !== 'undefined' ? oldInput.highlights : '' %></textarea>
                </div>

                <div class="form-group">
                <label for="coverImage">Upload Cover Image</label>
                <div class="file-upload-container">
                    <input type="file" id="coverImage" name="coverImage" class="file-input" accept="image/*">
                    <div class="file-upload-box">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <h4 class="upload-title">Add Cover Image</h4>
                        <p class="upload-text">Drag & drop image here or click to browse</p>
                        <small class="upload-hint">Recommended: 1200x600px (2:1 ratio), Max 5MB</small>
                    </div>
                    <div class="file-preview" id="imagePreview">
                        <img src="" alt="Image Preview" style="display: none;">
                    </div>
                </div>
                </div>
            </div>

        </div>

        <div class="form-section">
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label for="country">Country</label>
                    <select id="country" name="country" class="form-control" required>
                        <option value="">Select Country</option>
                        <% countries.forEach(function(country) { %>
                            <option value="<%= country._id %>" <%= (typeof oldInput !== 'undefined' && oldInput.country && oldInput.country.toString() === country._id.toString()) ? 'selected' : '' %>>
                                <%= country.name %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group col-md-3">
                    <label for="category">Categories</label>
                    <div class="custom-multiselect-container">
                        <div class="multiselect-trigger">
                            <div class="multiselect-placeholder">Select Categories</div>
                            <div class="multiselect-tags" id="selectedCategoriesTags"></div>
                            <i class="fas fa-chevron-down multiselect-arrow"></i>
                        </div>
                        <select id="category" name="category" class="custom-multiselect" multiple required>
                            <% // Categories will be loaded dynamically via JavaScript or server-side. %>
                        </select>
                        <div class="multiselect-dropdown" id="categoryDropdown">
                            <div class="multiselect-search">
                                <input type="text" class="multiselect-search-input" placeholder="Search categories...">
                            </div>
                            <div class="multiselect-options" id="categoryOptions">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label for="destinations">Destinations</label>
                    <div class="custom-multiselect-container">
                        <div class="multiselect-trigger">
                            <div class="multiselect-placeholder">Select Destinations</div>
                            <div class="multiselect-tags" id="selectedDestinationsTags"></div>
                            <i class="fas fa-chevron-down multiselect-arrow"></i>
                        </div>
                        <select id="destinations" name="destinations" class="custom-multiselect" multiple>
                            <option value="">Select Destinations</option>
                            <% if (typeof destinations !== 'undefined') { %>
                                <% destinations.forEach(function(dest) { %>
                                    <option value="<%= dest._id %>"><%= dest.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                        <div class="multiselect-dropdown" id="destinationsDropdown">
                            <div class="multiselect-search">
                                <input type="text" class="multiselect-search-input" placeholder="Search destinations...">
                            </div>
                            <div class="multiselect-options" id="destinationsOptions">
                                <% if (typeof destinations !== 'undefined') { %>
                                    <% destinations.forEach(function(dest) { %>
                                        <label class="multiselect-option">
                                            <input type="checkbox" value="<%= dest._id %>" data-label="<%= dest.name %>">
                                            <span><%= dest.name %></span>
                                        </label>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label for="days">Number of Days</label>
                    <input type="number" id="days" name="days" class="form-control" min="1" value="<%= typeof oldInput !== 'undefined' ? oldInput.days : '' %>" required>
                </div>

                <div class="form-group col-md-3">
                    <label for="price">Price ($)</label>
                    <input type="number" id="price" name="price" class="form-control" min="0" step="0.01" value="<%= typeof oldInput !== 'undefined' ? oldInput.price : '' %>" required>
                </div>
            </div>

            <div class="column-inputs">
                <div class="form-group">
                <label for="priceIncludes">Cost Includes</label>
                <textarea id="priceIncludes" name="priceIncludes" class="form-control" rows="5"><%= typeof oldInput !== 'undefined' ? oldInput.priceIncludes : '' %></textarea>
                </div>

                <div class="form-group">
                <label for="priceExcludes">Cost Excludes</label>
                <textarea id="priceExcludes" name="priceExcludes" class="form-control" rows="5" ><%= typeof oldInput !== 'undefined' ? oldInput.priceExcludes : '' %></textarea>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">Itineraries</h3>
            <div id="itinerariesContainer">
                <% if (typeof oldInput !== 'undefined' && oldInput.itineraries && oldInput.itineraries.length > 0) { %>
                    <% oldInput.itineraries.forEach(function(itinerary, index) { %>
                        <div class="itinerary-item">
                            <div class="itinerary-header">
                                <h4>Itinerary <%= index + 1 %></h4>
                                <button type="button" class="remove-itinerary-btn" title="Remove Itinerary">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-2 col-sm-2">
                                    <label>Day</label>
                                    <input type="text" name="itineraries[<%= index %>][day]" class="form-control"  value="<%= itinerary.day %>" required>
                                </div>

                                <div class="form-group col-md-10 col-sm-10">
                                    <label>Itinerary Title</label>
                                    <input type="text" name="itineraries[<%= index %>][title]" class="form-control" value="<%= itinerary.title %>" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Itinerary Description</label>
                                <div class="itinerary-editor editor-container"><%- itinerary.description %></div>
                                <input type="hidden" name="itineraries[<%= index %>][description]" value="<%= itinerary.description %>">
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Meal Plan</label>
                                    <select name="itineraries[<%= index %>][meals]" class="form-control" required>
                                        <option value="">Select Meal Plan</option>
                                        <option value="Lunch & Dinner" <%= (itinerary.meals === 'Lunch & Dinner') ? 'selected' : '' %>>Lunch & Dinner</option>
                                        <option value="Breakfast, Lunch & Dinner" <%= (itinerary.meals === 'Breakfast, Lunch & Dinner') ? 'selected' : '' %>>Breakfast, Lunch & Dinner</option>
                                        <option value="Breakfast & Lunch" <%= (itinerary.meals === 'Breakfast & Lunch') ? 'selected' : '' %>>Breakfast & Lunch</option>
                                        <option value="Breakfast Only" <%= (itinerary.meals === 'Breakfast Only') ? 'selected' : '' %>>Breakfast Only</option>
                                    </select>
                                </div>

                                <div class="form-group col-md-6">
                                    <label>Accommodation</label>
                                    <input type="text" name="itineraries[<%= index %>][accommodation]" class="form-control"  value="<%= itinerary.accommodation %>">
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="itinerary-item">
                        <div class="itinerary-header">
                            <h4>Itinerary 1</h4>
                            <button type="button" class="remove-itinerary-btn" title="Remove Itinerary">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-2 col-sm-2">
                                <label>Day</label>
                                <input type="text" name="itineraries[0][day]" class="form-control"  required>
                            </div>

                            <div class="form-group col-md-10 col-sm-10">
                                <label>Itinerary Title</label>
                                <input type="text" name="itineraries[0][title]" class="form-control" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Itinerary Description</label>
                            <div class="itinerary-editor editor-container"></div>
                            <input type="hidden" name="itineraries[0][description]">
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Meal Plan</label>
                                <select name="itineraries[0][meals]" class="form-control" required>
                                    <option value="">Select Meal Plan</option>
                                    <option value="Lunch & Dinner">Lunch & Dinner</option>
                                    <option value="Breakfast, Lunch & Dinner">Breakfast, Lunch & Dinner</option>
                                    <option value="Breakfast & Lunch">Breakfast & Lunch</option>
                                    <option value="Breakfast Only">Breakfast Only</option>
                                </select>
                            </div>

                            <div class="form-group col-md-6">
                                <label>Accommodation</label>
                                <input type="text" name="itineraries[0][accommodation]" class="form-control" >
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <button type="button" id="addItineraryBtn" class="btn btn-outline">
                <i class="fas fa-plus"></i> Add Itinerary
            </button>
        </div>

        <div class="form-section">
            <h3 class="section-title">SEO Information</h3>

            <div class="form-group">
                <label for="seoTitle">Meta Title</label>
                <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.seoTitle : '' %>" >
            </div>

            <div class="form-group">
                <label for="seoDescription">Meta Description</label>
                <textarea id="seoDescription" name="seoDescription" class="form-control" rows="3" maxlength="150"><%= typeof oldInput !== 'undefined' ? oldInput.seoDescription : '' %></textarea>
                <small id="charCount">0 / 150</small>
            </div>

            <div class="form-group">
                <label for="seoKeywords">Meta Keywords</label>
                <input type="text" id="seoKeywords" name="seoKeywords" class="form-control" value="<%= typeof oldInput !== 'undefined' ? oldInput.seoKeywords : '' %>" >
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Tour</button>
        </div>
    </form>
</div>

<script src="/js/multiselect.js"></script>
<link href="/css/multiselect.css" rel="stylesheet">
<link href="/css/form-enhancements.css" rel="stylesheet">

<script>
document.addEventListener('DOMContentLoaded', function() {
    const countrySelect = document.getElementById('country');
    const categorySelect = document.getElementById('category');

    
    function filterCategories() {
        const selectedCountryId = countrySelect.value;
        const categoryDropdown = document.getElementById('categoryDropdown');
        const categoryOptions = document.getElementById('categoryOptions');

        // Clear existing categories
        categoryOptions.innerHTML = '';
       

        if (selectedCountryId) {
            const apiUrl = `/api/categories/by-country/${selectedCountryId}`;

            fetch(apiUrl)
                .then(response => {
                    if (!response.ok) {
                        console.error('Frontend Script: Network response was not ok. Status:', response.status);
                        return response.text().then(text => { throw new Error('HTTP error ' + response.status + ': ' + text); });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.data && Array.isArray(data.data)) {
                        if (data.data.length === 0) {
                            console.warn('Frontend Script: No categories found for this country.');
                        }

                        // Clear the select element
                        categorySelect.innerHTML = '';

                        data.data.forEach(category => {
                            const option = document.createElement('option');
                            option.value = category._id;
                            option.textContent = category.name;
                            categorySelect.appendChild(option);

                            // Add to multiselect dropdown
                            const label = document.createElement('label');
                            label.className = 'multiselect-option';
                            label.innerHTML = `<input type="checkbox" value="${category._id}" data-label="${category.name}"><span>${category.name}</span>`;
                            categoryOptions.appendChild(label);
                        });

                        // Attempt to re-select categories if oldInput exists
                        let oldSelectedCategories = <%= JSON.stringify(typeof oldInput !== 'undefined' && oldInput.category ? oldInput.category : []) %>;
                        if (!Array.isArray(oldSelectedCategories)) {
                            oldSelectedCategories = [oldSelectedCategories];
                        }

                        if (oldSelectedCategories.length > 0) {
                            document.querySelectorAll('#categoryOptions input[type="checkbox"]').forEach(checkbox => {
                                if (oldSelectedCategories.includes(checkbox.value)) {
                                    checkbox.checked = true;
                                }
                            });
                        }

                        // Refresh the MultiSelect UI
                        if (window.multiSelectInstances && window.multiSelectInstances['category']) {
                            window.multiSelectInstances['category'].updateDisplay();
                        }
                    }
                })
                .catch(error => {
                    console.error('Error fetching categories:', error);
                });
        }
    }

    // Event listener for country select change
    countrySelect.addEventListener('change', filterCategories);
    
    // Initialize multiselect for categories and destinations
    setTimeout(() => {
        new MultiSelect('category', {
            placeholder: 'Select Categories'
        });
        new MultiSelect('destinations', {
            placeholder: 'Select Destinations'
        });
    }, 100);

    // Initial call to filter categories based on any pre-selected country
    if (countrySelect.value) {
        filterCategories();
    }

    // Image preview
    const coverImageInput = document.getElementById('coverImage');
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewImg = imagePreview.querySelector('img');

    coverImageInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreviewImg.src = e.target.result;
                imagePreviewImg.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            imagePreviewImg.src = '';
            imagePreviewImg.style.display = 'none';
        }
    });
});
</script>
