    <script>
    /**
     * Handles dynamic display of star rating based on selection.
     * @param {number} rating The selected rating value.
     */
    function updateStarRating(rating) {
        const starsContainer = document.getElementById('rating-preview');
        starsContainer.innerHTML = '';
        const fullStars = Math.floor(rating);
        const hasHalfStar = rating % 1 !== 0;

        for (let i = 1; i <= 5; i++) {
            let iconClass = 'bi-star'; // Default empty star
            if (i <= fullStars) {
                iconClass = 'bi-star-fill'; // Full star
            } else if (i === fullStars + 1 && hasHalfStar) {
                iconClass = 'bi-star-half'; // Half star
            }
            
            const star = document.createElement('i');
            star.className = `bi ${iconClass} text-warning me-1`;
            starsContainer.appendChild(star);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const ratingSelect = document.getElementById('rating');
        const sourceSelect = document.getElementById('source');

        // Initial setup
        updateSourceLogo();
        updateStarRating(parseFloat(ratingSelect.value));

        // Event listeners
        sourceSelect.addEventListener('change', updateSourceLogo);
        ratingSelect.addEventListener('change', (e) => updateStarRating(parseFloat(e.target.value)));
    });
</script>
