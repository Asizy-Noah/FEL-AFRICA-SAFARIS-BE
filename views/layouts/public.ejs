    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Selectors for the chat widget elements
            const whatsappBtn = document.querySelector('.whatsapp-btn');
            const chatBox = document.getElementById('chatBox');
            const chatInput = document.querySelector('.chat-input input');
            const chatSendBtn = document.getElementById('chatSendBtn'); // Use ID for direct selection
            const chatBody = document.getElementById('chatBody'); // Use ID for direct selection

            const whatsappNumber = '+256701041637'; // The desired WhatsApp number

            // --- Debugging Logs (Keep these for testing) ---
            console.log('--- WhatsApp Chat Widget Initializing ---');
            console.log('whatsappBtn element:', whatsappBtn);
            console.log('chatBox element:', chatBox);
            console.log('chatInput element:', chatInput);
            console.log('chatSendBtn element:', chatSendBtn);
            console.log('chatBody element:', chatBody);

            if (!whatsappBtn) console.error('ERROR: whatsappBtn not found!');
            if (!chatBox) console.error('ERROR: chatBox not found!');
            if (!chatInput) console.error('ERROR: chatInput not found!');
            if (!chatSendBtn) console.error('ERROR: chatSendBtn not found!');
            if (!chatBody) console.error('ERROR: chatBody not found!');

            // --- Event Listener for Floating WhatsApp Button (to toggle chat box) ---
            if (whatsappBtn && chatBox) {
                whatsappBtn.addEventListener('click', function() {
                    chatBox.classList.toggle('open'); // Toggle the 'open' class to show/hide
                    if (chatBox.classList.contains('open')) {
                        chatInput.focus(); // Focus input when chat box opens
                        chatBody.scrollTop = chatBody.scrollHeight; // Scroll to bottom
                    }
                });
            }

            // --- WhatsApp Chat Functionality (for the internal chat send button) ---
            if (chatSendBtn && chatInput && chatBody) {
                // Send message when button is clicked
                chatSendBtn.addEventListener('click', sendMessageToWhatsApp);

                // Send message when Enter key is pressed in the input field
                chatInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        sendMessageToWhatsApp();
                    }
                });
            } else {
                console.error('Chat input/send button/body not fully found. WhatsApp send functionality disabled.');
            }

            function sendMessageToWhatsApp() {
                const message = chatInput.value.trim();
                console.log('Attempting to send message:', message);

                if (message) {
                    // Encode the message for the URL
                    const encodedMessage = encodeURIComponent(message);

                    // Construct the WhatsApp URL
                    const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
                    console.log('Generated WhatsApp URL:', whatsappURL);

                    // Open WhatsApp in a new tab/window
                    window.open(whatsappURL, '_blank');

                    // --- Local Chat Display (Optional) ---
                    // Display the user's message in your local chat interface
                    const userMessageDiv = document.createElement('div');
                    userMessageDiv.className = 'chat-message user-message';
                    userMessageDiv.textContent = message;
                    chatBody.appendChild(userMessageDiv);

                    // Clear the input field
                    chatInput.value = '';

                    // Scroll to the bottom of the chat body to show the latest message
                    chatBody.scrollTop = chatBody.scrollHeight;

                    // Simulate a response (optional, for demo purposes)
                    setTimeout(() => {
                        const botResponseMessage = document.createElement('div');
                        botResponseMessage.className = 'chat-message';
                        botResponseMessage.textContent = "Thank you for your message! We'll get back to you on WhatsApp shortly.";
                        chatBody.appendChild(botResponseMessage);
                        chatBody.scrollTop = chatBody.scrollHeight;
                    }, 1500); // Simulate a delay for the bot's reply
                } else {
                    console.log('Message is empty. Not sending to WhatsApp.');
                }
            }

            // --- Pagination functionality (from your original snippet, kept for completeness) ---
            // Note: This part is unrelated to the WhatsApp chat but was in your original JS.
            const paginationLinks = document.querySelectorAll('.pagination .page-link');
            paginationLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.pagination .page-item').forEach(item => {
                        item.classList.remove('active');
                    });
                    if (!this.parentElement.classList.contains('disabled')) {
                        this.parentElement.classList.add('active');
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            });
        });
    </script>

