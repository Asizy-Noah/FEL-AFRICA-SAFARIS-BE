<footer class="footer">
    <div class="container">
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <img src="/img/feel_africa_safaris_logo.png" alt="Feel Africa Safaris" class="footer-logo">
                <p>Discover the adventure of Africa with Feel Africa Safaris, where authentic safari experiences meet luxury.</p>
            </div>

            <div class="col-md-3">
                <h5>Quick Links</h5>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/blogs">Our Blogs</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/enquiry">Enquiry</a></li>
                    <li><a href="/travel-policy">Our Travel Policy</a></li>
                    <li><a href="/terms-conditions">Terms and Conditions</a></li>
                </ul>
            </div>

            <div class="col-md-3">
                <h5>Top Destinations</h5>
                <ul class="footer-links">
                    <% if (locals.footerDestinations && footerDestinations.length > 0) { %>
                        <% footerDestinations.forEach(dest => { %>
                            <li><a href="/destinations/<%= dest.slug %>"><%= dest.name %></a></li>
                        <% }) %>
                    <% } else { %>
                        <li>No Destinations yet</a></li>
                    <% } %>
                </ul>
            </div>

            <div class="col-md-3">
                <h5>Our Partners</h5>
                <div class="partner-carousel-container">
                    <div class="carousel-wrapper">
                        <% if (locals.footerPartners && footerPartners.length > 0) { %>
                            <% footerPartners.forEach((partner, index) => { %>
                                <div class="carousel-slide <%= index === 0 ? 'active' : '' %>">
                                    <a href="<%= partner.websiteUrl %>" target="_blank">
                                        <img src="<%= partner.logo %>" alt="<%= partner.name %>" class="partner-logo">
                                    </a>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="carousel-slide active">
                                <p>Partnering with the best.</p>
                            </div>
                        <% } %>
                    </div>

                    <div class="carousel-dots">
                        <% if (locals.footerPartners) { %>
                            <% footerPartners.forEach((_, index) => { %>
                                <span class="dot <%= index === 0 ? 'active' : '' %>" onclick="currentSlide(<%= index %>)"></span>
                            <% }) %>
                        <% } %>
                    </div>

                    <button class="carousel-nav prev" onclick="changeSlide(-1)">&#10094;</button>
                    <button class="carousel-nav next" onclick="changeSlide(1)">&#10095;</button>
                </div>
            </div>
        </div>

        <hr>
        <div class="socials-footer py-2">
            <h5>Follow us on</h5>
            <div class="social-icons">
                <a href="#"><i class="fab fa-facebook"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-linkedin"></i></a>
            </div>
        </div>
        <hr>

        <div class="text-center py-3">
            <p>&copy; 2026 Feel Africa Safaris. All rights reserved.</p>
        </div>
    </div>
</footer>