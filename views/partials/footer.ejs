            <a class="text-white-50" href="/countries/zambia"><i class="fa fa-angle-right mr-2"></i>Zambia</a>
            <a class="text-white-50 mb-2" href="/countries/namibia"><i class="fa fa-angle-right mr-2"></i>Namibia</a>
            <a class="text-white-50" href="/countries/madagascar"><i class="fa fa-angle-right mr-2"></i>Madagascar</a>
        <%
