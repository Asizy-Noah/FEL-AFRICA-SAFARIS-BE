    <div class="d-flex flex-column justify-content-start">
        <%
        // Ensure popularFooterCountries exists and is an array before iterating
        if (typeof popularFooterCountries !== 'undefined' && Array.isArray(popularFooterCountries) && popularFooterCountries.length > 0) {
            popularFooterCountries.forEach(country => {
        %>
                <a class="text-white-50 mb-2" href="/countries/<%= country.slug %>">
                    <span class="fi fi-<%= country.code %> mr-2"></span><%= country.name %>
                </a>
        <%
            });
        } else {
            // Fallback if dynamic countries are not loaded or list is empty
        %>
            <a class="text-white-50 mb-2" href="/countries/uganda"><i class="fa fa-angle-right mr-2"></i>Uganda</a>
            <a class="text-white-50 mb-2" href="/countries/kenya"><i class="fa fa-angle-right mr-2"></i>Kenya</a>
