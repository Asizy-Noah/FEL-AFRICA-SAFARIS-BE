        <script>
class BlogCarousel {
    constructor() {
        this.carousels = new Map();
        this.init();
    }

    init() {
        const containers = document.querySelectorAll('.blog-carousel-container');
        containers.forEach(container => this.setupCarousel(container));
        this.setupNavButtons();
    }

    setupCarousel(container) {
        const track = container.querySelector('.carousel-track');
        const slides = container.querySelectorAll('.blog-carousel-slide');
        if (!track || slides.length === 0) return;

        const carouselId = Math.random().toString(36).substr(2, 9);
        this.carousels.set(carouselId, {
            container, track, slides,
            currentIndex: 0,
            isAnimating: false
        });

        const update = () => this.updateSlideDimensions(carouselId);
        window.addEventListener('resize', update);
        setTimeout(update, 100);
    }

    updateSlideDimensions(id) {
        const c = this.carousels.get(id);
        if (!c) return;
        const style = window.getComputedStyle(c.track);
        c.gap = parseFloat(style.gap) || 24;
        c.slideWidth = c.slides[0].offsetWidth;
        this.checkNavButtons(id);
    }

    checkNavButtons(id) {
        const c = this.carousels.get(id);
        const containerClass = Array.from(c.container.classList).find(cls => cls.endsWith('-carousel'));
        const prevBtn = document.querySelector(`.carousel-prev[data-carousel="${containerClass}"]`);
        const nextBtn = document.querySelector(`.carousel-next[data-carousel="${containerClass}"]`);

        if (!prevBtn || !nextBtn) return;

        const totalWidth = c.track.scrollWidth;
        const currentOffset = Math.abs(c.currentIndex * (c.slideWidth + c.gap));
        
        prevBtn.style.display = c.currentIndex === 0 ? 'none' : 'flex';
        nextBtn.style.display = (totalWidth - (currentOffset + c.container.offsetWidth)) <= 1 ? 'none' : 'flex';
    }

    setupNavButtons() {
        document.querySelectorAll('.blog-carousel-nav-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const name = e.currentTarget.dataset.carousel;
                const dir = e.currentTarget.classList.contains('carousel-next') ? 1 : -1;
                this.carousels.forEach((c, id) => {
                    if (c.container.classList.contains(name)) this.slideCarousel(id, dir);
                });
            });
        });
    }

    slideCarousel(id, dir) {
        const c = this.carousels.get(id);
        if (!c || c.isAnimating) return;

        const step = c.slideWidth + c.gap;
        const maxScroll = c.track.scrollWidth - c.container.offsetWidth;
        const maxIndex = Math.ceil(maxScroll / step);

        let newIndex = Math.max(0, Math.min(c.currentIndex + dir, maxIndex));
        if (newIndex === c.currentIndex) return;

        c.isAnimating = true;
        c.currentIndex = newIndex;
        let offset = Math.max(-(c.currentIndex * step), -maxScroll);

        c.track.style.transform = `translateX(${offset}px)`;
        setTimeout(() => {
            c.isAnimating = false;
            this.checkNavButtons(id);
        }, 600);
    }
}

document.addEventListener('DOMContentLoaded', () => new BlogCarousel());
</script>

