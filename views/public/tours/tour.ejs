        // ================================
        // BLOGS PAGE - CAROUSEL SYSTEM
        // ================================

        class BlogCarousel {
            constructor() {
                this.carousels = new Map();
                this.init();
            }

            init() {
                const carouselContainers = document.querySelectorAll('.blog-carousel-container');
                
                carouselContainers.forEach((container) => {
                    this.setupCarousel(container);
                });

                this.setupNavButtons();
            }

            setupCarousel(container) {
                const track = container.querySelector('.carousel-track');
                const slides = container.querySelectorAll('.blog-carousel-slide');
                
                if (!track || slides.length === 0) return;

                // Use the data-carousel attribute from the button to link to the container class
                // or a random ID if using multiple of the same type
                const carouselId = Math.random().toString(36).substr(2, 9);
                
                this.carousels.set(carouselId, {
                    container: container,
                    track: track,
                    currentIndex: 0,
                    slides: slides,
                    slideWidth: 0,
                    gap: 0,
                    isAnimating: false
                });

                // Initial setup and button check
                setTimeout(() => {
                    this.updateSlideDimensions(carouselId);
                }, 100);
                
                window.addEventListener('resize', () => this.updateSlideDimensions(carouselId));
            }

            updateSlideDimensions(carouselId) {
                const carousel = this.carousels.get(carouselId);
                if (!carousel) return;

                const firstSlide = carousel.slides[0];
                const computedStyle = window.getComputedStyle(carousel.track);
                carousel.gap = parseFloat(computedStyle.gap) || 24;
                carousel.slideWidth = firstSlide.offsetWidth;

                this.checkNavButtons(carouselId);
            }

            checkNavButtons(carouselId) {
                const carousel = this.carousels.get(carouselId);
                if (!carousel) return;

                // Find buttons related to this specific container
                const containerClass = Array.from(carousel.container.classList).find(c => c.endsWith('-carousel'));
                const prevBtn = document.querySelector(`.carousel-prev[data-carousel="${containerClass}"]`);
                const nextBtn = document.querySelector(`.carousel-next[data-carousel="${containerClass}"]`);

                if (!prevBtn || !nextBtn) return;

                const containerWidth = carousel.container.offsetWidth;
                const totalWidth = carousel.track.scrollWidth;
                const currentOffset = Math.abs(carousel.currentIndex * (carousel.slideWidth + carousel.gap));

                // 1. Hide both if content is smaller than container
                if (totalWidth <= containerWidth) {
                    prevBtn.style.display = 'none';
                    nextBtn.style.display = 'none';
                    return;
                }

                // 2. Logic for Prev Button (Hide if at start)
                prevBtn.style.display = carousel.currentIndex === 0 ? 'none' : 'flex';

                // 3. Logic for Next Button (Hide if no more content to the right)
                // We check if the current offset + container width is >= total track width
                const remainingSpace = totalWidth - (currentOffset + containerWidth);
                nextBtn.style.display = remainingSpace <= 1 ? 'none' : 'flex'; 
            }

            setupNavButtons() {
                document.querySelectorAll('.blog-carousel-nav-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const btnElement = e.currentTarget;
                        const carouselName = btnElement.dataset.carousel;
                        const direction = btnElement.classList.contains('carousel-next') ? 1 : -1;

                        this.carousels.forEach((carousel, id) => {
                            if (carousel.container.classList.contains(carouselName)) {
                                this.slideCarousel(id, direction);
                            }
                        });
                    });
                });
            }

            slideCarousel(carouselId, direction) {
                const carousel = this.carousels.get(carouselId);
                if (!carousel || carousel.isAnimating) return;

                const containerWidth = carousel.container.offsetWidth;
                const totalWidth = carousel.track.scrollWidth;
                const step = carousel.slideWidth + carousel.gap;
                
                // Calculate the maximum index that doesn't show empty space at the end
                const maxScroll = totalWidth - containerWidth;
                const maxIndex = Math.ceil(maxScroll / step);

                let newIndex = carousel.currentIndex + direction;

                // Stop movement if out of bounds (No looping)
                if (newIndex < 0) newIndex = 0;
                if (newIndex > maxIndex) newIndex = maxIndex;
                
                // If the index hasn't actually changed, don't animate
                if (newIndex === carousel.currentIndex) return;

                carousel.isAnimating = true;
                carousel.currentIndex = newIndex;

                // Calculate offset but ensure we don't scroll past the content
                let offset = -(carousel.currentIndex * step);
                if (Math.abs(offset) > maxScroll) {
                    offset = -maxScroll;
                }

                carousel.track.style.transform = `translateX(${offset}px)`;

                setTimeout(() => {
                    carousel.isAnimating = false;
                    this.checkNavButtons(carouselId);
                }, 600);
            }
        }

        // Initialize on DOM ready
        document.addEventListener('DOMContentLoaded', () => {
            new BlogCarousel();
        });

        // ================================
        // SMOOTH SCROLL BEHAVIOR
        // ================================
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // ================================
        // KEYBOARD NAVIGATION
        // ================================
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                const activeCarousel = document.activeElement?.closest('.blog-carousel-nav-btn');
                if (activeCarousel) {
                    activeCarousel.click();
                }
            } else if (e.key === 'ArrowRight') {
                const activeCarousel = document.activeElement?.closest('.blog-carousel-nav-btn');
                if (activeCarousel) {
                    activeCarousel.click();
                }
            }
        });

