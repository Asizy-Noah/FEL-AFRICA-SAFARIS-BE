    <section class="container description-section py-5 justify-content">
    <div class="row">
        <div class="col-lg-8 mb-5 mt-4 mb-lg-0 justify-content"> 
            <h4 class=" post-title mb-4"><%= tour.title %></h4>
            <section class="intro-section mb-5 justify-content">
                <%- tour.overview %>
            </section>

            <section class="highlights-section">
                <div class="mb-2">
                    <h3 class="m-0 font-weight-bold sub-headngs">Tour Highlights</h3>
                </div>
                <ul class="highlight-list">
                    <% if (tour.highlights) { %>
                        <% tour.highlights.split('\n').map(line => line.trim()).filter(line => line).forEach(function(item) { %>
                            <li><%= item %></li>
                        <% }); %>
                    <% } else { %>
                        <li>Highlights coming soon...</li>
                    <% } %>
                </ul>
            </section>

            <section class="itinerary-section">
                <div class="mb-2">
                    <h3 class="m-0 font-weight-bold sub-headngs">Detailed Itinerary Day By Day</h3>
                </div>
                
                <% if (tour.itineraries && tour.itineraries.length > 0) { %>
                    <% tour.itineraries.forEach(function(itinerary) { %>
                        <div class="itinerary-item">
                            <div class="itinerary-header" onclick="toggleItinerary(this)">
                                <h3>Day <%= itinerary.day %>: <%= itinerary.title %></h3>
                                <i class="fas fa-chevron-down"></i>
                            </div>
                            <div class="itinerary-content">
                                <div class="itinerary-details justify-content">
                                    <%- itinerary.description %>
                                </div>
                                <div class="itinerary-meta">
                                    <% if (itinerary.accommodation) { %>
                                        <div class="itinerary-meta-item">
                                            <h4>Accommodation</h4>
                                            <p><%= itinerary.accommodation %></p>
                                        </div>
                                    <% } %>
                                    <% if (itinerary.meals) { %>
                                        <div class="itinerary-meta-item">
                                            <h4>Meal Plan</h4>
                                            <p><%= itinerary.meals %></p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No detailed itinerary available for this tour.</p>
                <% } %>
            </section>

            <section class="cost-section">
                <div class="cost-container">
                    <div class="cost-box">
                        <h3>Cost Includes</h3>
                        <ul class="cost-list cost-includes">
                            <% if (tour.priceIncludes) { %>
                                <% tour.priceIncludes.split('\n').map(line => line.trim()).filter(line => line).forEach(function(item) { %>
                                    <li><%= item %></li>
                                <% }); %>
                            <% } else { %>
                                <li>Contact us for inclusion details.</li>
                            <% } %>
                        </ul>
                    </div>
                    
                    <div class="cost-box">
                        <h3>Cost Excludes</h3>
                        <ul class="cost-list cost-excludes">
                            <% if (tour.priceExcludes) { %>
                                <% tour.priceExcludes.split('\n').map(line => line.trim()).filter(line => line).forEach(function(item) { %>
